{
  "expo": {
    "name": "Project Evolve",
    "slug": "project-evolve",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "android": {
      "package": "com.projectevolve.app",
      "adaptiveIcon": {
        "backgroundColor": "#0A0D12"
      }
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Project Evolve accede a tus fotos solo para adjuntar una imagen privada a tu plan semanal.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
